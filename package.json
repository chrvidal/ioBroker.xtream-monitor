{
  "name": "iobroker.xtream-monitor",
  "version": "0.2.10",
  "description": "Monitor multiple Xtream-compatible accounts in ioBroker",
  "author": "chrvidal",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "xtream",
    "monitoring",
    "endpoint",
    "api",
    "availability"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "watch:ts": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "test:package": "mocha test/package.js --exit",
    "test:integration": "npm run build && mocha test/integration.js --exit",
    "test": "npm run test:package && npm run test:integration"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrvidal/ioBroker.xtream-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/chrvidal/ioBroker.xtream-monitor/issues"
  },
  "homepage": "https://github.com/chrvidal/ioBroker.xtream-monitor#readme"
}
