{
  "i18n": true,
  "type": "panel",
  "items": {
    "intro": {
      "type": "staticText",
      "newLine": true,
      "text": "Add all Xtream-compatible endpoints that should be monitored. Technical server IDs are managed internally.",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "servers": {
      "type": "table",
      "label": "Servers",
      "newLine": true,
      "sm": 12,
      "compact": true,
      "showSecondAddAt": 5,
      "useCardFor": [
        "xs",
        "sm"
      ],
      "titleAttribute": "name",
      "items": [
        {
          "type": "checkbox",
          "title": "Enabled",
          "attr": "enabled",
          "width": 80,
          "default": true
        },
        {
          "type": "text",
          "title": "Name",
          "attr": "name",
          "width": 140,
          "defaultFunc": "(() => { const idx = Number(arrayIndex) + 1; return 'Server ' + (idx > 0 ? idx : 1); })()"
        },
        {
          "type": "text",
          "title": "Host / Server URL",
          "attr": "host",
          "width": 260,
          "default": ""
        },
        {
          "type": "text",
          "title": "Username",
          "attr": "username",
          "width": 180,
          "default": ""
        },
        {
          "type": "password",
          "title": "Password",
          "attr": "password",
          "width": 180,
          "default": ""
        }
      ],
      "xs": 12,
      "md": 12,
      "lg": 12,
      "xl": 12,
      "encryptedAttributes": [
        "password"
      ]
    },
    "pollIntervalMinutes": {
      "type": "number",
      "label": "Check interval",
      "help": "Minutes between checks",
      "min": 1,
      "max": 1440,
      "step": 1,
      "unit": "min",
      "newLine": true,
      "sm": 12,
      "md": 4,
      "xs": 12,
      "lg": 4,
      "xl": 4
    },
    "timeoutSeconds": {
      "type": "number",
      "label": "Request timeout",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "s",
      "newLine": false,
      "sm": 12,
      "md": 4,
      "xs": 12,
      "lg": 4,
      "xl": 4
    },
    "logStatusChanges": {
      "type": "checkbox",
      "label": "Log online/offline status changes",
      "help": "Disabled by default to avoid log spam. Only real status transitions are logged.",
      "newLine": false,
      "sm": 12,
      "md": 4,
      "xs": 12,
      "lg": 4,
      "xl": 4
    }
  }
}
